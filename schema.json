{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of this schema, for editors."
    },
    "emit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "JSDoc for the emitted type."
          },
          "group_by": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "tag",
                  "method"
                ],
                "title": "GroupBy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Emit one type per distinct value. An operation with several tags\n appears in each of their groups."
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "title": "Template"
                }
              }
            ],
            "description": "`map` only. Each entry is one level of nesting. Operations whose keys\n collide are unioned."
          },
          "kind": {
            "type": "string",
            "enum": [
              "union",
              "map"
            ],
            "title": "EmitKind"
          },
          "match": {
            "type": "object",
            "properties": {
              "deprecated": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "has_body": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "method": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "A value that can be written as `x` or `[x, y]`.",
                    "title": "List"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "`\"GET\"` / `[\"GET\", \"HEAD\"]`, case-insensitive."
              },
              "not": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Selector"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "operation_id": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "A value that can be written as `x` or `[x, y]`.",
                    "title": "List"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "A value that can be written as `x` or `[x, y]`.",
                    "title": "List"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Path globs: `*` matches within one segment, `**` any number of\n segments. `/shop/**`, `**/items/*`, `/v*/users`."
              },
              "tag": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "A value that can be written as `x` or `[x, y]`.",
                    "title": "List"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Matches if the operation has any of these tags."
              }
            },
            "additionalProperties": false,
            "description": "Which operations this covers (a selector, as in `[filter]`). `{}` is\n all of them.",
            "title": "Selector"
          },
          "name": {
            "type": "string",
            "description": "Type name. May use `{tag}` / `{method}` when grouped by it.",
            "title": "Template"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "description": "Deserialised from (and serialised to) its source string, so it reads as\n a plain string in config files and in the generated config schema.\n\n Deserialising never fails: facet discards a proxy's conversion error, so\n a malformed template keeps its error and reports it from\n [`Template::check`], which config validation runs on load.",
                "title": "Template"
              },
              {
                "type": "null"
              }
            ],
            "description": "TS type for each operation, with `{type}` as the operation's type name.\n Defaults to `{type}`. Operations missing a variable it uses are skipped."
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "description": "Aggregate types over operations: `kind = \"union\"` gives\n `export type Name = A | B`, `kind = \"map\"` gives\n `export interface Name { [key]: A }`.\n\n ```toml\n [[emit]]\n name = \"{Tag}Routes\"          # one type per tag\n group_by = \"tag\"\n match = { method = \"GET\" }\n kind = \"map\"\n key = [\"{path}\", \"{method}\"]  # '/shop/items': { get: GetShopItems }\n value = \"{type}['response']\"  # defaults to \"{type}\"\n ```",
        "title": "Emit"
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "exclude": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "deprecated": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "has_body": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "method": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "`\"GET\"` / `[\"GET\", \"HEAD\"]`, case-insensitive."
                },
                "not": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Selector"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operation_id": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Path globs: `*` matches within one segment, `**` any number of\n segments. `/shop/**`, `**/items/*`, `/v*/users`."
                },
                "tag": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Matches if the operation has any of these tags."
                }
              },
              "additionalProperties": false,
              "title": "Selector"
            },
            {
              "type": "null"
            }
          ],
          "description": "Minus operations matching this."
        },
        "include": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "deprecated": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "has_body": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "method": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "`\"GET\"` / `[\"GET\", \"HEAD\"]`, case-insensitive."
                },
                "not": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Selector"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operation_id": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Path globs: `*` matches within one segment, `**` any number of\n segments. `/shop/**`, `**/items/*`, `/v*/users`."
                },
                "tag": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "A value that can be written as `x` or `[x, y]`.",
                      "title": "List"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Matches if the operation has any of these tags."
                }
              },
              "additionalProperties": false,
              "title": "Selector"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only operations matching this (everything if unset)."
        }
      },
      "additionalProperties": false,
      "title": "Filter"
    },
    "formats": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "`format` -> TS type to use instead of the base type, e.g.\n `binary = \"Blob\"`, `date-time = \"Date\"`. Applies to string/number/integer."
    },
    "header": {
      "type": "string",
      "description": "Prepended verbatim to the output. `\"\"` for none."
    },
    "jsdoc": {
      "type": "boolean",
      "description": "Emit `/** @description ... */` comments."
    },
    "operation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Type name template, e.g. `\"{operationId|pascal}\"`. Operations missing\n a variable it uses (no `operationId`) fall back to `\"{Method}{Path}\"`.",
          "title": "Template"
        },
        "no_content_key": {
          "type": "string",
          "description": "Content-type key for bodiless responses (e.g. 204) when\n `response = \"by_content_type\"`."
        },
        "params": {
          "type": "string",
          "enum": [
            "split",
            "merged"
          ],
          "description": "How `request` params are grouped.",
          "title": "ParamsLayout"
        },
        "response": {
          "type": "string",
          "enum": [
            "by_content_type",
            "by_status"
          ],
          "description": "How the `response` map is nested.",
          "title": "ResponseLayout"
        }
      },
      "additionalProperties": false,
      "title": "OperationConfig"
    },
    "readonly": {
      "type": "boolean",
      "description": "Emit `readonly` for `readOnly: true` properties."
    },
    "schemas": {
      "type": "object",
      "properties": {
        "emit": {
          "type": "string",
          "enum": [
            "referenced",
            "all"
          ],
          "description": "`\"referenced\"`: only schemas the generated operations use, directly or\n through other schemas. `\"all\"`: every schema in the spec.",
          "title": "SchemaEmit"
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names (`*` wildcards allowed) to generate even when unreferenced, e.g.\n types only used by client code or named in an `[[emit]]` `value`.\n Whatever they reference is kept too."
        }
      },
      "additionalProperties": false,
      "title": "SchemasConfig"
    },
    "single_quote": {
      "type": "boolean",
      "description": "`'GET'` instead of `\"GET\"`."
    }
  },
  "additionalProperties": false,
  "description": "opi configuration: the built-in defaults, written out. Every key\n is optional; copy only what you want to change. Lists and tables replace\n the default rather than merging, so defining any `[[emit]]` drops the\n `Paths` one below.\n\n Templates (`name`, `key`, `value`): `{method}` `{path}` `{operationId}` `{tag}` `{type}`\n   `{method}` -> get, `{Method}` -> Get, `{METHOD}` -> GET\n   `{Path}` on \"/components/{name}\" -> ComponentsByName\n   filters: `{tag|camel}`, `{operationId|pascal}`, `|lower`, `|upper`\n\n Selectors (`[filter]`, `match`): fields are ANDed, a list ORs.\n   method = \"GET\" | [\"GET\", \"HEAD\"]\n   path = \"/shop/**\"        (* = within one segment, ** = any segments)\n   tag = \"shop\", operation_id = \"getItem\", deprecated = true, has_body = false\n   not = { ... }",
  "title": "Config"
}