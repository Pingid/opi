{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path or URL of this file's JSON Schema, for editors. Ignored.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "source": {
      "description": "Source OpenAPI spec: a .json, .yaml or .yml file relative to this\nfile, or an http(s) URL. The CLI's `openapi` argument takes precedence.\nExample:\n```yaml\nsource: https://petstore3.swagger.io/api/v3/openapi.json\n```",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "formats": {
      "description": "Schema `format` -> the TS type to use instead of the base type, for\nstrings, numbers and integers. `{}` turns it off.\nExample:\n```yaml\nformats: { binary: Blob, date-time: Date }\n```",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {
        "binary": "Blob"
      }
    },
    "rules": {
      "description": "Rules whose output goes to the CLI's `output` argument, or stdout.\nEmpty when omitted; the built-in rules only apply without a config.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "default": []
    }
  },
  "additionalProperties": {
    "type": "array",
    "items": {
      "$ref": "#/$defs/Rule"
    }
  },
  "$defs": {
    "Rule": {
      "description": "Top-level rule representing one transform entry in the YAML/JSON list.",
      "type": "object",
      "properties": {
        "each": {
          "anyOf": [
            {
              "$ref": "#/$defs/Each"
            },
            {
              "type": "null"
            }
          ]
        },
        "where": {
          "anyOf": [
            {
              "$ref": "#/$defs/Where"
            },
            {
              "type": "null"
            }
          ]
        },
        "emit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Emit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Each": {
      "description": "Handles either a simple string (`\"route\"`) or a nested map (`{ route: \"response\" }`).",
      "anyOf": [
        {
          "$ref": "#/$defs/EachObject"
        },
        {
          "$ref": "#/$defs/EachBare"
        }
      ]
    },
    "EachObject": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "schema"
          ]
        },
        {
          "type": "object",
          "properties": {
            "route": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EachRoute"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "route"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EachRoute": {
      "description": "Which part of a route to iterate: its request bodies or its responses.",
      "type": "string",
      "enum": [
        "request",
        "response"
      ]
    },
    "EachBare": {
      "type": "string",
      "enum": [
        "route",
        "schema"
      ]
    },
    "Where": {
      "type": "object",
      "properties": {
        "deprecated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhereRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhereResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/Method"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WhereRequest": {
      "type": "object",
      "properties": {
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "deprecated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "WhereResponse": {
      "type": "object",
      "properties": {
        "status": {
          "description": "A status code; matches only that code, not a `2XX` range.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "deprecated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "Method": {
      "description": "An HTTP method, case-insensitive: get, put, post, delete, options, head, patch, trace, query, or any other a spec uses.",
      "type": "string"
    },
    "Emit": {
      "type": "object",
      "properties": {
        "type": {
          "description": "Defaults per item: `{name}` for schemas, `{method}{path}` for routes,\n`{method}{path}Request` / `{method}{path}{status}Response`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "description": "Omitted: the item as itself. A schema, request or response is its type;\na route is `{ method, path, request, response }`.",
          "anyOf": [
            {
              "$ref": "#/$defs/EmitFields"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Template": {
      "description": "Literal text with `{variable}` placeholders; `{{` and `}}` are literal braces.",
      "type": "string"
    },
    "EmitFields": {
      "anyOf": [
        {
          "$ref": "#/$defs/Template"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EmitFields"
          }
        }
      ]
    }
  }
}
